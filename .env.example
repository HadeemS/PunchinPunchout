# Neon pooled connection (app runtime — hostname contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# Neon direct connection (Prisma Migrate / admin). neon deploy also writes DATABASE_URL_UNPOOLED.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Min 32 random characters — generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-32+-random-chars"

# Neon Auth (written by `neon deploy` when auth: true in neon.ts)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
NEON_BRANCH=
NEON_BRANCH_ID=

ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_FULL_NAME="Administrator"
